      "score": 1.0,
      "access_count": 0
    },
    "verify_after_opening_app": {
      "value": "Always verify after opening any app using screen_process. Wait for the app to fully load (use 5-10 seconds delay or more for heavier apps like YouTube/Unigram) before calling screen_process to confirm the app is actually open and visible. Never assume an app opened successfully just because the tool returned success.",
      "updated": "2026-06-28",
