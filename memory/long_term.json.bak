  "preferences": {
    "computer_control_protocol": {
      "value": "Priority approach for computer control: ALWAYS use a 'See -> Locate -> Act -> Verify' workflow. 1. Capture screen via screen_process. 2. Use the 10px coordinate grid to find precise coordinates. 3. Verify cursor focus before typing. 4. Post-execution, analyze screen again to verify the task was completed correctly. Never act blindly.",
      "updated": "2026-06-23",
      "score": 8.093700525984088,
      "access_count": 73
    },
